# procura-contracts — deploy/tooling environment (EXAMPLE)
# Copy to `.env` and fill in. NEVER commit the real .env.

# Network for CLI scripts: local | testnet | mainnet
STELLAR_NETWORK=testnet

# Stellar RPC endpoint used by deploy scripts
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Secret key used ONLY by deploy scripts. This key becomes the contract admin.
# It has NO access to any engagement's escrowed funds.
# Provide via your shell / CI secret store — do not paste real values here.
DEPLOYER_SECRET=S...replace_me...

# SEP-41 token the escrow contract is initialized with (payment asset)
TOKEN_CONTRACT_ID=C...replace_me...

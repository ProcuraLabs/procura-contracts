# Rust / Cargo
/target/
**/target/
# Library workspace: keep Cargo.lock unlocked (remove this line for a binary).
Cargo.lock
**/*.rs.bk
*.pdb

# Soroban / Stellar build artifacts
*.wasm
.soroban/
.stellar/
# regenerated by soroban-sdk on `cargo test`
test_snapshots/

# Environment & secrets — NEVER commit these
.env
.env.*
!.env.example
*.key
*.pem
secret*.txt
identity*.toml
deployer*.json

# Editor / OS
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
.DS_Store
Thumbs.db

# Logs
*.log
